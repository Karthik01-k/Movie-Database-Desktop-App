<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.moviedb.controller.RegisterController"
           styleClass="bg-base">

    <VBox alignment="CENTER" spacing="20" maxWidth="400">
        <padding><Insets top="60" bottom="60" left="40" right="40"/></padding>

        <Label text="Create Account" styleClass="title-1"/>

        <VBox spacing="8">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="Choose a username"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Email"/>
            <TextField fx:id="emailField" promptText="your@email.com"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Min. 6 characters"/>
        </VBox>

        <Label fx:id="errorLabel" styleClass="danger" wrapText="true" visible="false" managed="false"/>

        <Button text="Create Account" styleClass="button-filled"
                maxWidth="Infinity" onAction="#onRegister"/>

        <HBox alignment="CENTER" spacing="6">
            <Label text="Already have an account?"/>
            <Hyperlink text="Sign In" onAction="#onGoLogin"/>
        </HBox>
    </VBox>
</StackPane>
